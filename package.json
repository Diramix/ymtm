{
	"name": "@diram1x/ymtm",
	"version": "3.6.1",
	"description": "Yandex Music Theme Maker",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"ymtm": "./bin/ymtm.js"
	},
	"main": "dist/cli.js",
	"files": [
		"bin",
		"dist"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "tsc --noEmit && bun build src/cli.ts --target bun --outdir dist --format esm --minify",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"engines": {
		"node": ">=18"
	},
	"license": "MIT",
	"dependencies": {
		"bun": "^1.1.0",
		"sass": "^1.99.0"
	},
	"devDependencies": {
		"@types/bun": "^1.1.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.2"
	}
}
