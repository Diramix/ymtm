{
	"compilerOptions": {
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"strict": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"declaration": false,
		"types": ["bun"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
